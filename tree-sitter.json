{
  "grammars": [
    {
      "name": "perl",
      "camelcase": "Perl",
      "scope": "source.perl",
      "path": ".",
      "file-types": [
        "pl", "pm", "t"
      ],
      "first-line-regex": "#!.*\\bperl$"
    }
  ],
  "metadata": {
    "version": "1.1.2",
    "license": "MIT",
    "description": "a tree-sitter for perl language.",
    "namespace": "io.ganezdragon.tree-sitter-perl",
    "authors": [
      {
        "name": "ganezdragon",
        "email": "ganesh.raja.93@gmail.com"
      }
    ],
    "links": {
      "repository": "git://github.com/ganezdragon/tree-sitter-perl.git"
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "node": true,
    "python": false,
    "rust": true,
    "swift": false
  }
}
